# Copy to .env.local (git-ignored). These two values are public by design — they're shipped in the
# browser bundle. Your data is protected by row-level security and checked database functions.

# Supabase → Project Settings → API (or "Connect"): Project URL and the anon / publishable key.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# For local development against `npm run db:start`, use the values printed by `npx supabase status`:
#   VITE_SUPABASE_URL=http://127.0.0.1:54321
#   VITE_SUPABASE_ANON_KEY=<local anon key>

# Only for installing the schema on your hosted project (never in the browser, never committed):
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
