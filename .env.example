# Copy to .env and fill in what you need. Never commit .env (it's git-ignored).

# Port the server listens on.
PORT=3000

# Where data is stored.
# Production: your Supabase connection string. In the Supabase dashboard open your project → "Connect"
# → copy the "Session pooler" URI and put your database password in it:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Leave empty for local development: a PGlite database (real Postgres, in-process) lives in ./data/pglite.
DATABASE_URL=

# Optional: path to Supabase's CA certificate (Project Settings → Database → SSL Configuration) so the
# TLS connection is fully verified. Without it the connection is still encrypted.
DATABASE_SSL_CA=

# Set to false only for a non-TLS Postgres that isn't on localhost.
DATABASE_SSL=

# Set to true when served over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false

# Set to true when running behind a reverse proxy (Render, Fly, nginx…) so client IPs are correct.
TRUST_PROXY=false

# Password for the two demo accounts created by `npm run seed` (development only).
SEED_PASSWORD=garden-demo-1
# `npm run seed` refuses a real Postgres DATABASE_URL unless this is true (keeps demo data out of Supabase).
SEED_ALLOW_REMOTE=
