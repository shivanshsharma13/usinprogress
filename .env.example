# Copy to .env (or export these) — all are optional.

# Port the server listens on.
PORT=3000

# SQLite database file. The folder is created automatically.
DATABASE_PATH=./data/us-in-progress.db

# Set to true when served over HTTPS so the session cookie is marked Secure.
COOKIE_SECURE=false

# Set to true when running behind a reverse proxy (Fly, Render, nginx…) so client IPs are correct.
TRUST_PROXY=false

# Password used by `npm run seed` for the two demo accounts (development only).
SEED_PASSWORD=garden-demo-1
