{
  "name": "us-in-progress",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private, shared study garden for two friends.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run lint && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint",
    "db:start": "supabase start -x vector,logflare,imgproxy,studio,storage-api,edge-runtime,mailpit,postgres-meta",
    "db:reset": "supabase db reset",
    "test": "supabase db reset && node --test --test-timeout=30000 tests/*.test.ts",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed-local.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.59.20",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.39.5",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.5",
    "supabase": "^2.122.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5"
  }
}
