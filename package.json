{
  "name": "us-in-progress",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A private, shared study garden for two friends.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.ts",
    "seed": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/seed.ts",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.59.20",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.5",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  }
}
